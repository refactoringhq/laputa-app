#!/bin/sh
# Pre-push (personal-fork edition):
#   - TypeScript build (catches type breakage)
#   - Frontend tests (catches regressions, no coverage gate)
#   - Rust clippy + rustfmt (only when src-tauri/ changed)
#
# Dropped vs upstream: frontend coverage threshold, Rust llvm-cov ≥85%,
# CodeScene ratchet, Playwright smoke. Run those manually via package.json
# scripts when you want them.
set -e

ensure_node_tooling() {
  if command -v node >/dev/null 2>&1 && command -v pnpm >/dev/null 2>&1; then
    return 0
  fi

  NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck disable=SC1090
    . "$NVM_DIR/nvm.sh" --no-use
    nvm use --silent node >/dev/null 2>&1 || true
  fi

  if ! command -v node >/dev/null 2>&1 || ! command -v pnpm >/dev/null 2>&1; then
    echo "❌ node and pnpm must be available before pushing"
    echo "   Install them or make sure your nvm setup is available to git hooks."
    exit 1
  fi
}

ensure_cargo_tooling() {
  if command -v cargo >/dev/null 2>&1; then
    return 0
  fi
  if [ -s "$HOME/.cargo/env" ]; then
    # shellcheck disable=SC1091
    . "$HOME/.cargo/env"
  fi
}

require_not_detached() {
  if ! git symbolic-ref -q HEAD >/dev/null 2>&1; then
    echo "❌ Detached HEAD is not allowed for pushes."
    exit 1
  fi
}

require_not_detached
ensure_node_tooling
ensure_cargo_tooling

START_TIME=$(date +%s)

echo ""
echo "🚀 Pre-push checks (personal-fork lite)"
echo "================================================"

# ── Detect what changed ─────────────────────────────────────────────────
PUSH_TARGET=$(git rev-parse @{push} 2>/dev/null || echo "")
RUST_CHANGED=true

if [ -n "$PUSH_TARGET" ]; then
  CHANGED=$(git diff --name-only "$PUSH_TARGET"..HEAD)
  if ! echo "$CHANGED" | grep -qE '^(src-tauri/|Cargo)'; then
    RUST_CHANGED=false
  fi
fi

# ── 1. TypeScript + Vite build ──────────────────────────────────────────
echo ""
echo "📦 [1/3] TypeScript + Vite build..."
pnpm exec tsc --noEmit
pnpm build
echo "  ✅ Build OK"

# ── 2. Frontend tests (no coverage threshold) ───────────────────────────
echo ""
echo "🧪 [2/3] Frontend unit tests..."
pnpm exec vitest run --silent
echo "  ✅ Tests OK"

# ── 3. Rust clippy + rustfmt (only when Rust changed) ───────────────────
echo ""
if [ "$RUST_CHANGED" = true ] && command -v cargo >/dev/null 2>&1; then
  echo "🔧 [3/3] Clippy + rustfmt..."
  cargo clippy --manifest-path=src-tauri/Cargo.toml -- -D warnings
  cargo fmt --manifest-path=src-tauri/Cargo.toml -- --check
  echo "  ✅ Rust lint OK"
elif [ "$RUST_CHANGED" = true ]; then
  echo "⏭️  [3/3] Rust lint — skipped (cargo not in PATH; install rustup if you want this gate)"
else
  echo "⏭️  [3/3] Rust lint — skipped (no src-tauri/ changes)"
fi

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))
MINUTES=$((ELAPSED / 60))
SECONDS=$((ELAPSED % 60))

echo ""
echo "================================================"
echo "✅ All checks passed — pushing (${MINUTES}m ${SECONDS}s)"
echo ""
